<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.grimm</groupId>
        <artifactId>grimm-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>grimm-processor</artifactId>
    <name>Grimm :: APT Processor</name>
    <description>Annotation processor generating $$GrimmModel companion sources at compile time for JAX-RS resources (APT-first rule, codegen audit CG-06). Builds the real model objects inside javac (grimm-core) and embeds the serialized fragment.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.grimm</groupId>
            <artifactId>grimm-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- JAX-RS annotations read by the processor (provided, like in grimm-core). -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- grimm-core requires the MicroProfile Config and Jakarta Annotations modules, which it only
             declares as provided: the module-path test run must find them. -->
        <dependency>
            <groupId>io.vidocq.ravel</groupId>
            <artifactId>ravel-mp-config-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Disable annotation processing during the processor's own compilation
                         to avoid circular bootstrap issues. -->
                    <proc>none</proc>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- The oracle test drives grimm-core's runtime scanner, which grimm-core does not export to the processor. -->
                            <compilerArgs combine.children="append">
                                <arg>--add-exports</arg>
                                <arg>io.vidocq.grimm.core/io.vidocq.grimm.internal.config=io.vidocq.grimm.processor</arg>
                                <arg>--add-exports</arg>
                                <arg>io.vidocq.grimm.core/io.vidocq.grimm.internal.scanner=io.vidocq.grimm.processor</arg>
                                <arg>--add-exports</arg>
                                <arg>io.vidocq.grimm.core/io.vidocq.grimm.internal.serialization=io.vidocq.grimm.processor</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Tests run on the module path; the oracle test drives grimm-core's runtime scanner. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>
                        --add-exports io.vidocq.grimm.core/io.vidocq.grimm.internal.config=io.vidocq.grimm.processor
                        --add-exports io.vidocq.grimm.core/io.vidocq.grimm.internal.scanner=io.vidocq.grimm.processor
                        --add-exports io.vidocq.grimm.core/io.vidocq.grimm.internal.serialization=io.vidocq.grimm.processor
                    </argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
