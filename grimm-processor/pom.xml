<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.grimm</groupId>
        <artifactId>grimm-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>grimm-processor</artifactId>
    <name>Grimm :: APT Processor</name>
    <description>Annotation processor generating $$GrimmModel companion sources at compile time for JAX-RS resources (APT-first rule, codegen audit CG-06). Builds the real model objects inside javac (grimm-core) and embeds the serialized fragment.</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.grimm</groupId>
            <artifactId>grimm-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- JAX-RS annotations read by the processor (provided, like in grimm-core). -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Java Modules: module-info.java sits in src/main/module-info/ so that testCompile stays on the
                class path (test-scope dependencies are not modules). It is compiled alone at prepare-package
                and ships in the jar: Grimm's jars are named modules, never automatic ones (grimm#15).
                A module-info.class left in target/classes by a previous build would switch the main
                compile to module mode before the module path is complete: it is removed first.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <id>remove-stale-module-info-before-compile</id>
                        <phase>process-resources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Disable annotation processing during the processor's own compilation
                         to avoid circular bootstrap issues. -->
                    <proc>none</proc>
                </configuration>
                <executions>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
