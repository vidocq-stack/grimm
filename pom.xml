<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vidocq</groupId>
    <artifactId>vidocq-parent</artifactId>
    <version>0.4.0-RC1</version>
    <relativePath />
  </parent>

  <groupId>io.vidocq.grimm</groupId>
  <artifactId>grimm-parent</artifactId>
  <version>0.4.0-RC1</version>
  <packaging>pom</packaging>

  <name>Grimm</name>
  <description>MicroProfile OpenAPI 4.2 implementation for Vidocq</description>
  <url>https://codefloe.com/Vidocq/grimm</url>

  <developers>
    <developer>
      <name>Yann Blazart</name>
      <email>yann.blazart@gmail.com</email>
    </developer>
    <developer>
      <name>Antoine Sabot-Durand</name>
      <email>antoine@sabot-durand.net</email>
    </developer>
  </developers>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

  <scm>
    <connection>scm:git:https://codefloe.com/Vidocq/grimm.git</connection>
    <developerConnection>scm:git:ssh://git@codefloe.com/Vidocq/grimm.git</developerConnection>
    <url>https://codefloe.com/Vidocq/grimm</url>
    <tag>HEAD</tag>
  </scm>

  <modules>
    <module>grimm-core</module>
    <module>grimm-processor</module>
    <module>grimm-cdi-vauban</module>
    <module>grimm-it-other-containers</module>
    <module>grimm-bench</module>
    <module>grimm-examples</module>
  </modules>

  <properties>
    
    <vauban.version>0.4.0-RC1</vauban.version>
    <cassini.version>0.4.0-RC1</cassini.version>
    <chappe.version>0.4.0-RC1</chappe.version>
    <ravel.version>0.4.0-RC1</ravel.version>

    <version.mp.openapi>4.2-RC5</version.mp.openapi>
    <version.jakarta.ws.rs>4.0.0</version.jakarta.ws.rs>
    <version.jakarta.cdi>4.1.0</version.jakarta.cdi>
    <version.jakarta.annotation>3.0.0</version.jakarta.annotation>
    <version.jakarta.validation>3.1.1</version.jakarta.validation>

    
    <ci.tck.command>mvn -B -ntp -f grimm-tck/pom.xml -Ptck-official test -Dgrimm.version="$(mvn -B -ntp -q -N help:evaluate -Dexpression=project.version -DforceStdout)"</ci.tck.command>

    
    <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/grimm-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    <sonar.coverage.exclusions>**/grimm-examples/**</sonar.coverage.exclusions>
    <sonar.issue.ignore.multicriteria>examples</sonar.issue.ignore.multicriteria>
    <sonar.issue.ignore.multicriteria.examples.ruleKey>java:S106</sonar.issue.ignore.multicriteria.examples.ruleKey>
    <sonar.issue.ignore.multicriteria.examples.resourceKey>**/grimm-examples/**/src/main/java/**</sonar.issue.ignore.multicriteria.examples.resourceKey>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eclipse.microprofile.openapi</groupId>
        <artifactId>microprofile-openapi-api</artifactId>
        <version>${version.mp.openapi}</version>
      </dependency>
      <dependency>
        <groupId>io.vidocq.ravel</groupId>
        <artifactId>ravel-mp-config-api</artifactId>
        <version>${ravel.version}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.ws.rs</groupId>
        <artifactId>jakarta.ws.rs-api</artifactId>
        <version>${version.jakarta.ws.rs}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.enterprise</groupId>
        <artifactId>jakarta.enterprise.cdi-api</artifactId>
        <version>${version.jakarta.cdi}</version>
      </dependency>
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>${version.jakarta.annotation}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    
    <profile>
      <id>quality</id>
      <modules>
        <module>grimm-coverage</module>
      </modules>
    </profile>
  </profiles>
</project>