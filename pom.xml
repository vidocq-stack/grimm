<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vidocq</groupId>
    <artifactId>vidocq-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <relativePath />
  </parent>

  <groupId>io.vidocq.grimm</groupId>
  <artifactId>grimm-parent</artifactId>
  <version>0.4.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Grimm</name>
  <description>MicroProfile OpenAPI 4.2 implementation for Vidocq</description>
  <url>https://codefloe.com/Vidocq/grimm</url>

  <developers>
    <developer>
      <name>Yann Blazart</name>
      <email>yann.blazart@gmail.com</email>
    </developer>
    <developer>
      <name>Antoine Sabot-Durand</name>
      <email>antoine@sabot-durand.net</email>
    </developer>
  </developers>

