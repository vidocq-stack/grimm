<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.vidocq.grimm</groupId>
    <artifactId>grimm-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
  </parent>

  <artifactId>grimm-cdi-vauban</artifactId>
  <name>grimm-cdi-vauban</name>

  <dependencies>
    <dependency>
      <groupId>io.vidocq.grimm</groupId>
      <artifactId>grimm-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.eclipse.microprofile.openapi</groupId>
      <artifactId>microprofile-openapi-api</artifactId>
    </dependency>
    <dependency>
      <groupId>io.vidocq.ravel</groupId>
      <artifactId>ravel-mp-config-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.ws.rs</groupId>
      <artifactId>jakarta.ws.rs-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.enterprise</groupId>
      <artifactId>jakarta.enterprise.cdi-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!--
      Vauban API (provided): referenced only by the Vauban APT-generated infrastructure
      (_Factory / _ClientProxy / _VaubanComponents). Build-time only — no runtime coupling to
      a specific Vauban version beyond the stable component SPI. Pinned to the runtime line (0.2.x)
      so the generated metadata is consumed correctly by the Vidocq runtime.
    -->
    <dependency>
      <groupId>io.vidocq.vauban</groupId>
      <artifactId>vauban-api</artifactId>
      <version>0.3.0-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>io.vidocq.cassini</groupId>
      <artifactId>cassini-chappe</artifactId>
      <version>0.3.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vidocq.chappe</groupId>
      <artifactId>chappe-api</artifactId>
      <version>0.3.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vidocq.chappe</groupId>
      <artifactId>chappe-core</artifactId>
      <version>0.3.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.vidocq.vauban</groupId>
      <artifactId>vauban-core</artifactId>
      <version>0.3.0-SNAPSHOT</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own beans, so the jar ships
        as a functional Vauban bean archive (META-INF/vauban-beans.list + _Factory / _ClientProxy /
        _VaubanComponents). Combined with META-INF/services BCE registration and META-INF/beans.xml,
        this lets any Vidocq runtime discover grimm's beans and run GrimmExtension (which synthesises
        GrimmModelCache) without scanning the dependency from the consumer. Build-time only; the
        output is inert for a standard CDI container (Weld). module-info stays uncompiled here (the
        jar remains an automatic module) — consistent with the rest of grimm.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <executions>
          <!-- Vauban APT on MAIN sources only: produces the bean infrastructure shipped in the jar. -->
          <execution>
            <id>default-compile</id>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>io.vidocq.vauban</groupId>
                  <artifactId>vauban-processor</artifactId>
                  <version>0.3.0-SNAPSHOT</version>
                </path>
              </annotationProcessorPaths>
            </configuration>
          </execution>
          <!-- No annotation processing on tests: grimm's CDI test fixtures (nested producers) are
               not vauban-APT-shaped and are exercised via vauban's embedded runtime discovery. -->
          <execution>
            <id>default-testCompile</id>
            <configuration>
              <proc>none</proc>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

